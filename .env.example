# Polynovea CMS OSS V1 — environment template
# Copy to .env.local for local development. Never commit real secrets.

# Required application runtime (Supabase/PostgREST-compatible profile)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for migrations and the persistent delivery worker
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Required when encrypted connection/delivery configuration is enabled.
# Generate exactly 32 random bytes and encode them as base64.
CMS_CONFIG_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Optional delivery signing fallback
CMS_DELIVERY_SIGNING_SECRET=

# Optional website revalidation integration
WEBSITE_URL=
WEBSITE_REVALIDATE_SECRET=

# Optional Cloudflare R2 / S3-compatible media reference adapter
R2_ACCOUNT_ID=
R2_S3_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=media
R2_PUBLIC_URL=

# Optional Google Analytics 4 integration
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Optional CLI / MCP client defaults
POLYNOVEA_CMS_URL=http://localhost:3000
POLYNOVEA_CMS_TOKEN=

# Optional first-admin bootstrap defaults. Prefer passing --email explicitly.
POLYNOVEA_BOOTSTRAP_ADMIN_EMAIL=
POLYNOVEA_BOOTSTRAP_ADMIN_USERNAME=
POLYNOVEA_BOOTSTRAP_ADMIN_DISPLAY_NAME=
POLYNOVEA_DEFAULT_WORKSPACE_SLUG=polynovea
